<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <!-- World map pin: the map canvas acquires pins by template (MapCanvasMixin:AcquirePin). -->
  <Frame name="LvlsMapPinTemplate" mixin="LvlsMapPinMixin" enableMouse="true" virtual="true">
    <Size x="16" y="16"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon" setAllPoints="true"/>
      </Layer>
    </Layers>
  </Frame>
</Ui>
